NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co

# Clave publicable (dashboard nuevo) — preferida
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# O clave anon JWT (legacy), si no usás publishable
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional: npm run migrate — solo en .env.local, no commitear
# DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxxx.supabase.co:5432/postgres

NEXT_PUBLIC_APP_URL=http://localhost:3000

# WhatsApp del local (opcional, icono en header)
NEXT_PUBLIC_WHATSAPP_E164=5492610000000
NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com

# Dominio sintético para login solo con usuario
# NEXT_PUBLIC_AUTH_LOGIN_DOMAIN=casio.local
